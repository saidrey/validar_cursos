<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sitemap estático para las rutas públicas de estructura fija.
  Las rutas dinámicas (/cursos/:id) no se incluyen aquí porque requieren
  conocer los IDs en build time. En producción se generaría un sitemap
  dinámico consultando el backend (ver sección de mejoras en SEO_IMPLEMENTATION.md).
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <url>
    <loc>https://www.aulavirtualcentrodecompetencia.com/</loc>
    <!-- changefreq indica cada cuánto cambia la página. Google lo toma como sugerencia. -->
    <changefreq>weekly</changefreq>
    <!-- priority va de 0.0 a 1.0. Solo sirve para priorizar entre URLs del mismo sitio. -->
    <priority>1.0</priority>
  </url>

  <url>
    <loc>https://www.aulavirtualcentrodecompetencia.com/cursos</loc>
    <!-- El catálogo cambia cuando se agregan nuevos cursos → daily -->
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>

  <url>
    <loc>https://www.aulavirtualcentrodecompetencia.com/validar</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>

  <url>
    <loc>https://www.aulavirtualcentrodecompetencia.com/contacto</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>

</urlset>
